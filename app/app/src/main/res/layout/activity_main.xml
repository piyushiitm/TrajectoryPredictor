<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/legend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:padding="8dp"
        android:background="#CC000000"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="13sp"
        android:text="● GPS ● IMU ● hold ● GPSbrg+AI"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#11141C"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E8EEF7"
            android:textSize="12sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="13sp"
            android:fontFamily="monospace"
            android:text="waiting for GNSS fix…" />

        <TextView
            android:id="@+id/mount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#7FD8C4"
            android:textSize="12sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="13sp"
            android:fontFamily="monospace"
            android:text="mount: —" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOutage"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Outage"
                android:textSize="12sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="13sp"
                android:maxLines="1"
                android:insetLeft="0dp"
                android:insetRight="0dp" />

            <Button
                android:id="@+id/btnRecord"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Record"
                android:textSize="12sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="13sp"
                android:maxLines="1"
                android:insetLeft="0dp"
                android:insetRight="0dp" />

            <Button
                android:id="@+id/btnSource"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="AI speed"
                android:textSize="12sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="13sp"
                android:maxLines="1"
                android:insetLeft="0dp"
                android:insetRight="0dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHeading"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Hdg: GYRO"
                android:textSize="12sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="13sp"
                android:maxLines="1"
                android:insetLeft="0dp"
                android:insetRight="0dp" />

            <Button
                android:id="@+id/btnMap"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Map: off"
                android:textSize="12sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="13sp"
                android:maxLines="1"
                android:insetLeft="0dp"
                android:insetRight="0dp" />

            <Button
                android:id="@+id/btnHead"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Map: off"
                android:textSize="12sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="13sp"
                android:maxLines="1"
                android:insetLeft="0dp"
                android:insetRight="0dp" />

        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
